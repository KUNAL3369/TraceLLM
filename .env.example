# Supabase (required)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend-facing Supabase (required for auth)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend API URL (required for production)
VITE_API_URL=http://localhost:3001
VITE_FRONTEND_URL=http://localhost:5173

# LLM Providers (at least one required for live inference)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Notifications (optional, for alerts)
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:5173

# Redis (optional, enables BullMQ queue for ingestion)
REDIS_URL=
